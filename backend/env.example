# Backend Environment — Copy this to .env
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://docuforge:docuforge_dev_pass@localhost:5432/docuforge
JWT_ACCESS_SECRET=change_this_access_secret_in_production_at_least_64_chars
JWT_REFRESH_SECRET=change_this_refresh_secret_in_production_at_least_64_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=./uploads

# Google Sign-In (optional). Leave empty to hide the Google button.
# Create an OAuth 2.0 Web client in Google Cloud Console and add your
# frontend origin (e.g. http://localhost:3000) under Authorized JavaScript origins.
GOOGLE_CLIENT_ID=
