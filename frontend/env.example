# Frontend Environment — Copy this to .env.local
NEXT_PUBLIC_API_URL=http://localhost:3001

# Optional: same Google OAuth Web client ID as backend GOOGLE_CLIENT_ID.
# The login UI loads the client ID from GET /api/v1/auth/google/config, so this
# is only needed if you want to reference it from other client code.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
